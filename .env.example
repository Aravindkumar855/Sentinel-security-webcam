# Sentinel Security Webcam Configuration
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
SESSION_SECRET=sentinel-dev-secret-key-change-in-production-123456789
DATABASE_PATH=./data/sentinel.db
RECORDINGS_DIR=./data/recordings

# WebRTC STUN / TURN Configuration
# Separate multiple STUN URLs with commas
STUN_SERVERS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302

# Optional TURN Relay Configuration (needed when devices are on symmetric NATs / strict firewalls)
TURN_SERVER=
TURN_USERNAME=
TURN_CREDENTIAL=

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
